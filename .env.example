# Copia este archivo a .env.local y completa los valores.
# Crea tu proyecto en https://www.sanity.io/manage

# ID y dataset del proyecto (público — se puede exponer al navegador)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-17

# Token de lectura para el Live Content API (servidor — NO usar prefijo NEXT_PUBLIC_)
# Crear en manage.sanity.io → API → Tokens → Agregar token (rol: Viewer)
SANITY_API_READ_TOKEN=

# Token de escritura para el script de seed (rol: Editor o superior)
SANITY_WRITE_TOKEN=
